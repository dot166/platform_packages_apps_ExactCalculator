android_app {
    name: "ExactCalculator",

    product_specific: true,

    overrides: ["Calculator"],

    sdk_version: "current",

    resource_dirs: ["res"],
    srcs: ["src/**/*.java"],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    static_libs: [
        "cr",
        "j.Lib",
        "kotlin-stdlib",
    ],
}
